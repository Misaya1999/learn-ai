# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Docker Compose development database initialization
POSTGRES_DB=learnai
POSTGRES_USER=learnai
POSTGRES_PASSWORD=replace-with-development-password
POSTGRES_ADMIN_PASSWORD=replace-with-admin-development-password

# Backend
APP_NAME=LearnAI API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://learnai:replace-with-strong-password@localhost:5432/learnai
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DOCUMENT_STORAGE_DIR=backend/storage/documents
DOCUMENT_MAX_UPLOAD_SIZE=10485760
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=200
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_EMBEDDING_BATCH_SIZE=100
OPENAI_CHAT_MODEL=gpt-4.1-mini
AI_TUTOR_MAX_OUTPUT_TOKENS=500
AI_TUTOR_RETRIEVAL_TOP_K=5
AI_TUTOR_MAX_CONTEXT_CHARACTERS=12000
QUIZ_GENERATION_MAX_CONTEXT_CHARACTERS=16000
QUIZ_GENERATION_MAX_OUTPUT_TOKENS=4000
